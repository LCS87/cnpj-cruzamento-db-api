# Configurações do Banco de Dados MySQL
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=cnpj_db
DB_USER=root
DB_PASSWORD=sua_senha_aqui

# Configurações da API Invertexto
API_TOKEN=seu_token_aqui
API_BASE_URL=https://api.invertexto.com/v1/cnpj/

# Configurações do Sistema
INPUT_FOLDER=input
OUTPUT_FOLDER=output_cruzamento
LOG_LEVEL=INFO
TIMEOUT_API=30
MAX_RETRIES=3

# --- Segurança (Fase 1) ---
AUTH_REQUIRED=true
# Gere chaves com: python -m api.keygen
API_KEYS=troque-esta-chave-api
RATE_LIMIT_PER_MIN=60
MAX_UPLOAD_SIZE_MB=25
ENVIRONMENT=development
JOB_DB_PATH=jobs.db

# --- Fase 2: Pipeline assíncrono + cache de API ---
# Consultas simultâneas à API Invertexto (recomendado 5-10; respeite o rate limit do plano)
API_CONCURRENCY=5
# TTL do cache local de consultas (dias). 0 desativa o cache.
API_CACHE_TTL_DIAS=7
# Caminho do SQLite do cache (padrão: ./api_cache.db na raiz do projeto)
API_CACHE_PATH=api_cache.db

# --- Fase 3: Observabilidade ---
# Formato dos logs: text (humano, com request_id) ou json (uma linha JSON por log, p/ Loki/ELK/Sentry)
LOG_FORMAT=text
# Endpoint /metrics exige API key por padrão; true libera para scraping interno (use rede protegida)
METRICS_PUBLICA=false
# Sentry opcional: deixe vazio para desativar. Requer: pip install sentry-sdk
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
